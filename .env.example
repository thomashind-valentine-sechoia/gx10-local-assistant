# Copy this file to .env and adjust for your machine.
#   cp .env.example .env
# Never commit .env. All values below are placeholders or safe defaults.

# Timezone used by Compose services
TZ=Europe/London

# Home Assistant configuration directory (mounted at /config)
HA_CONFIG_DIR=${HOME}/homeassistant

# Fast LLM caches (scripts/run-llm.sh)
HF_HOME=${HOME}/models/hf
VLLM_CACHE_DIR=${HOME}/models/vllm-cache

# Parakeet STT volume roots (compose)
STT_DATA_DIR=${HOME}/models/onnx-asr/data
STT_CACHE_DIR=${HOME}/models/onnx-asr/cache

# Offline Wikipedia and SearXNG
KIWIX_DIR=${HOME}/kiwix
SEARXNG_CONFIG_DIR=${HOME}/searxng/config
SEARXNG_DATA_DIR=${HOME}/searxng/data

# Optional Qwen3-TTS Hugging Face cache and speaker
# HF_DIR=${HOME}/models/qwen3-tts
# SPEAKER=Ryan
# Optional directory of *your* reference clips for custom voices.
# Leave unset or empty to skip. Never commit recordings.
# TTS_CLONE_VOICES_DIR=${HOME}/voice-clones

# Optional home directory of a second user that runs the Ask Claude CLI
# bridge. Leave empty if you do not use that integration.
# ASK_CLAUDE_HOME=

# Directory for configuration-only backup archives (scripts/backup.sh)
# BACKUP_ROOT=${HOME}/gx10-backups
